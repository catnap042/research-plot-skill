figure.facecolor: white
axes.facecolor: white
font.family: sans-serif
font.sans-serif: Arial, Helvetica, DejaVu Sans
font.size: 16
axes.titlesize: 20
axes.labelsize: 16
xtick.labelsize: 14
ytick.labelsize: 14
legend.fontsize: 14
axes.edgecolor: 666666
axes.labelcolor: 333333
text.color: 333333
xtick.color: 333333
ytick.color: 333333
axes.linewidth: 1.0
lines.linewidth: 2.2
lines.markersize: 5
axes.spines.top: False
axes.spines.right: False
axes.grid: False
xtick.direction: out
ytick.direction: out
legend.frameon: False
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
savefig.dpi: 300
