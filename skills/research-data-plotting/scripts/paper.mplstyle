figure.facecolor: white
axes.facecolor: white
font.family: sans-serif
font.sans-serif: Arial, Helvetica, DejaVu Sans
font.size: 8
axes.titlesize: 9
axes.labelsize: 8
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 7
axes.edgecolor: 333333
axes.labelcolor: 333333
text.color: 333333
xtick.color: 333333
ytick.color: 333333
axes.linewidth: 0.7
lines.linewidth: 1.2
lines.markersize: 3.5
axes.spines.top: False
axes.spines.right: False
axes.grid: False
xtick.direction: out
ytick.direction: out
legend.frameon: False
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
savefig.dpi: 600
